{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "svgbutton",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "cache": { "enabled": true },
  "assets": { "directory": "./dist/assets", "binding": "ASSETS" },
  "build": {
    "command": "npm run build:icons && npm run build:editor",
    "watch_dir": ["src", "scripts"]
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.css", "**/*.txt"], "fallthrough": false }
  ]
}
