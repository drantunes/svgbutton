{
  "name": "mastra-button",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build:editor": "esbuild src/editor.ts --bundle --minify --format=esm --target=es2022 --outfile=dist/editor.js.txt",
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:unit": "node --test tests/unit.test.ts",
    "test:integration": "node --test tests/integration.test.ts",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run --outdir dist/worker"
  },
  "dependencies": {
    "hono": "^4.13.21",
    "saxes": "^6.0.0",
    "svg-pathdata": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "wrangler": "^4.168.0"
  }
}
